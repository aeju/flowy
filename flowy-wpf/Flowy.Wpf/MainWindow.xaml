<Window x:Class="Flowy.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flowy"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- 세로로 2개 행 분할: 상단 KPI / 하단 본문 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0행: 내용 높이만큼만 (KPI) -->
            <RowDefinition Height="*"/>    <!-- 1행: 본문 -->
            <RowDefinition Height="Auto"/> <!-- 2행: 내용 높이만큼만 (Alert) -->
        </Grid.RowDefinitions>
        
        <!-- 상단 KPI (0행) -->
        <TextBlock Grid.Row="0" Text="{Binding AvailabilityText}"
                   FontSize="18" FontWeight="Bold" Margin="10"/>

        <!-- 본문 (1행): 좌우 2컬럼을 가진 안쪽 Grid -->
        <Grid Grid.Row="1">
            <!-- Grid를 좌우 2개 컬럼으로 분할 (좌: 제어 버튼, 우: 공정 목록) -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <!-- 0번 컬럼: 폭 130px 고정 -->
                <ColumnDefinition Width="*"/>
                <!-- 1번 컬럼: 남는 공간 전부 차지 (*는 나머지 전체) -->
            </Grid.ColumnDefinitions>

            <!-- 좌측 제어 영역. Grid.Column="0" = 0번 컬럼에 배치 -->
            <!-- StackPanel: 자식 요소를 세로로 쌓는 컨테이너 (버튼을 위→아래로 나열) -->
            <StackPanel Grid.Column="0" Margin="10">
                <!-- Command: 버튼 클릭 시 ViewModel의 AssignProductCommand 실행 -->
                <!-- Margin="0,0,0,6" = 아래쪽만 6px 간격 / Padding="6" = 버튼 안쪽 여백 -->
                <Button Content="제품 투입" Command="{Binding AssignProductCommand}" Margin="0,0,0,6" Padding="6"/>
                <Button Content="설비 정지" Command="{Binding StopCommand}" Margin="0,0,0,6" Padding="6"/>
                <Button Content="재가동" Command="{Binding RestartCommand}" Margin="0,0,0,6" Padding="6"/>
                <Button Content="가속 ▲" Command="{Binding SpeedUpCommand}" Margin="0,0,0,6" Padding="6"/>
                <Button Content="감속 ▼" Command="{Binding SpeedDownCommand}" Padding="6"/>
            </StackPanel>

            <!-- 우측 공정 목록. Grid.Column="1" = 1번 컬럼에 배치 -->
            <!-- ItemsSource: ViewModel의 Processes 목록을 이 ListBox에 연결 -->
            <ListBox Grid.Column="1" ItemsSource="{Binding Processes}" Margin="10">
                <!-- ItemTemplate: 목록의 각 항목을 어떻게 그릴지 정의 -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Orientation="Horizontal": 이름과 상태를 가로로 나란히 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusText}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <!-- 하단 Alert (2행) -->
        <TextBlock Grid.Row="2" Text="{Binding AlertText}"
                   FontSize="14" Foreground="#D93F33" Margin="10"/>
    </Grid>
</Window>
