<Window x:Class="Flowy.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flowy"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- ItemsSource: 이 목록 컨트롤이 뿌릴 데이터 = ViewModel의 Processes -->
        <!-- {Binding Processes}: DataContext(=MainViewModel)의 Processes 프로퍼티를 찾아 연결 -->
        <ListBox ItemsSource="{Binding Processes}" Margin="20"/>
    </Grid>
</Window>
